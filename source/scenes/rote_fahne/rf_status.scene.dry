@moscow
title: Moscow
new-page: true
is-special: true
on-arrival: {!
var RF = window.RF;
Q.overrule_risk = Math.round(100 * RF.overruleChance(Q));
RF.moscowStatus(Q);
RF.numbers(Q);
!}

= Moscow

{!<div class="rf-block"><div class="rf-block-head">The line</div>!}

{!<p><span class="tooltip-text" title="The Comintern's strategy for Germany, set at each plenum. Factions whose ideas fit it gain standing in Moscow.">Line</span>: !}[? if line == "united_front" : united front ?][? if line == "insurrection" : insurrection ?][? if line == "bolshevization" : Bolshevisation ?][? if line == "class_against_class" : class against class ?]{!</p>!}

{!<p><span class="tooltip-text" title="The last plenum's task for the KPD. The next plenum praises the leadership if it is met and rebukes it if not; two rebukes bring an Open Letter.">Directive</span>: !}[+ directive +] [? if directive_on_track = 1 : {!<span class="rf-chip rf-chip-good">on track</span>!} ?][? if directive_on_track = 0 : {!<span class="rf-chip rf-chip-bad">behind</span>!} ?]{!</p>!}

{!<p><span class="tooltip-text" title="When Moscow next judges the party.">Next plenum</span>: !}[+ next_plenum +]{!</p></div>!}

{!<div class="rf-block"><div class="rf-block-head">The party and Moscow</div>!}

{!<p><span class="tooltip-text" title="How far the KPD still decides for itself. Every intervention wears it down; the lower it is, the faster Moscow's pressure grows and the easier Moscow overturns a congress.">Autonomy</span>: !}[+ autonomy : rf_autonomy +][+ n_autonomy +]{!</p>!}

{!<p><span class="tooltip-text" title="How hard Moscow is pushing to put its favourite in charge. At its peak Moscow demands that the next congress install its favourite; a strong, self-governing party can refuse.">Pressure</span>: !}[+ overrule_risk : rf_overrule +][+ n_overrule_risk +]{!</p>!}

{!<p>Moscow favours: !}<span class="f-[+ favourite +]">[+ favourite_name +]</span>{!</p>!}

[? if open_letter = 1 : {!<p><span class="rf-chip rf-chip-bad">Open Letter</span> Moscow demands a special congress to replace the leadership.</p>!} ?][? if open_letter = 0 and moscow_rebukes = 1 : {!<p><span class="rf-chip rf-chip-bad">Rebuked once</span> A second rebuke brings an Open Letter.</p>!} ?]

[? if moscow_news != "" : {!<p><i>!}[+ moscow_news +]{!</i></p>!} ?]{!</div>!}

{!<div class="rf-block"><div class="rf-block-head"><span class="tooltip-text" title="The Russian leaders who decide the Comintern's course. Their power depends partly on the Russian party and partly on what the KPD does. Hover a name to see which faction he backs.">The Kremlin</span></div><div id="rf-kremlin"></div></div>!}

[? if congress_news != "" : *Last congress: [+ congress_news +]* ?]

@forces
title: Forces
new-page: true
is-special: true
on-arrival: {!
var RF = window.RF;
RF.openingStatus(Q);
var base = RF.risingBase(Q);
Q.rising_chance = Math.round(100 * Math.max(0, Math.min(1, (base + 30 - 140) / 30)));
Q.rev_support = RF.revSupport(Q);
RF.numbers(Q);
!}

#The armed formations are drawn by RF.renderForces (rote_fahne.js):
#strength and militarisation as words, details in the hover cards; head
#counts only with exact numbers switched on.

= The armed power of the state

{!<div id="rf-state-forces"></div>!}

{!<span class="tooltip-text" title="Police and courts acting against the party: bans, raids, arrests.">State repression</span>!}: [+ repression : rf_level +][+ n_repression +]

[? if emergency != "" : **[+ emergency +]** ?]

= Paramilitaries

{!<div id="rf-paramilitaries"></div>!}

{!<span class="tooltip-text" title="Weapons, training and plans for an armed rising.">The party's armed readiness</span>!}: [+ readiness : rf_level +][+ n_readiness +]

= The mood of the people

{!<span class="tooltip-text" title="How many Germans back the democratic Republic. Hyperinflation drains it; stability restores it.">Support for the Republic</span>!}: [+ pro_republic : rf_level +]

{!<span class="tooltip-text" title="Nationalist feeling. The Ruhr occupation feeds it, and it feeds the DNVP and the völkisch right.">Support for nationalism</span>!}: [+ nationalism : rf_level +]

{!<span class="tooltip-text" title="How far the people, above all the workers, would back a revolution: the revolutionary situation, the party's vote, the unions and the SPD's workers, against support for the Republic and repression. A rough guide, not a verdict: it counts for a little in the chance of a rising, while plans, allies and arms count for more.">Support for revolution</span>!}: [+ rev_support : rf_revsupport +][+ n_rev_support +]

{!<span class="tooltip-text" title="Hunger, strikes and anger at the Republic. It rises with inflation and falls once the currency is stable.">Revolutionary situation</span>!}: [+ rev_situation : rf_rev +][+ n_rev_situation +]

{!<span class="tooltip-text" title="Communist strength in the trade unions and factory councils.">Influence in the unions</span>!}: [+ union_influence : rf_level +][+ n_union_influence +]

{!<span class="tooltip-text" title="Whether SPD workers would follow a call to arms. Good relations with the SPD count for a lot.">SPD workers</span>!}: [? if spd_relation >= 60 : might follow ?][? if spd_relation < 60 and spd_relation >= 35 : wary ?][? if spd_relation < 35 : would not follow ?][+ n_spd_relation +]

{!<span class="tooltip-text" title="An opening for revolution needs two things at once: a state in crisis, and a party able to use it. It opens when the revolutionary situation runs high and closes when that fades. An opening that closes unused does not come back.">The opening</span>!}: [+ opening_text +]

{!<span class="tooltip-text" title="The party's strength to use an opening: arms and plans, its hold on the unions, its unity and its apparatus.">The party's strength to use it</span>!}: [+ subjective : rf_level +][+ n_subjective +]

{!<span class="tooltip-text" title="Readiness, the revolutionary situation, support for revolution, the unions, the SPD's workers and state repression, against a Reichswehr and police far stronger than the party.">Chance of a rising</span>!}: [+ rising_chance : rf_odds +][+ n_rising_chance +]

