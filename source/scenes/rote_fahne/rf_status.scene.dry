title: Status
new-page: true
is-special: true
on-arrival: {!
window.RF.updateReich(Q);
window.RF.numbers(Q);
!}

= Status

[+ month : month +] [+ year +]

Resources: [+ funds +]

{!<span class="col-kpd">KPD</span>!} position: [+ kpd_position +]

Internal dissent: [+ party_dissent : rf_party_dissent +][+ n_party_dissent +]

= Government

Government: [+ government +]

President: [+ president +]

Chancellor: [+ chancellor +]

[? if emergency != "" : **[+ emergency +]** ?]

Reichstag, share of seats (elected June 1920):

{!<div id="rf-reichstag"></div>!}

{!<span class="tooltip-text" title="The Reichstag elected in June 1920 sits for four years, unless it is dissolved sooner.">Next election</span>!}: [+ next_election +]

@party
title: Inside the Party
new-page: true
is-special: true
on-arrival: {!
var RF = window.RF;
Q.overrule_risk = Math.round(100 * RF.overruleChance(Q));
RF.moscowStatus(Q);
Q.next_congress = RF.nextCongressText(Q);
Q.zentrale_text = RF.zentraleText(Q);
RF.spdStatus(Q);
RF.numbers(Q);
!}

= Inside the KPD

Leadership: <span class="f-[+ leader +]">[+ leader_name +]</span>

{!<span class="tooltip-text" title="The leadership only changes at a party congress, where the delegates elect a new Zentrale. The statutes call for a congress about once a year, and Moscow may try to overturn the delegates' choice.">Next party congress</span>!}: [+ next_congress +]

[? if right_formed = 1 and right_expelled = 0 : {!<div class="rf-faction">!}<span class="f-right">Brandler Right</span>{!<div class="rf-stat">!}Strength: [+ right_strength : strength +][+ n_right_strength +]{!</div><div class="rf-stat">!}Dissent: [+ right_dissent : rf_dissent +][+ n_right_dissent +]{!</div>!}{!</div>!} ?][? if right_formed = 1 and right_expelled = 1 : <span class="f-right">Brandler Right</span>: left the party ?]

[? if center_formed = 1 and center_expelled = 0 : {!<div class="rf-faction">!}<span class="f-center">Middle Group</span>{!<div class="rf-stat">!}Strength: [+ center_strength : strength +][+ n_center_strength +]{!</div><div class="rf-stat">!}Dissent: [+ center_dissent : rf_dissent +][+ n_center_dissent +]{!</div>!}{!</div>!} ?][? if center_formed = 1 and center_expelled = 1 : <span class="f-center">Middle Group</span>: left the party ?]

[? if left_formed = 1 and left_expelled = 0 : {!<div class="rf-faction">!}<span class="f-left">Fischer–Maslow Left</span>{!<div class="rf-stat">!}Strength: [+ left_strength : strength +][+ n_left_strength +]{!</div><div class="rf-stat">!}Dissent: [+ left_dissent : rf_dissent +][+ n_left_dissent +]{!</div>!}{!</div>!} ?][? if left_formed = 1 and left_expelled = 1 : <span class="f-left">Fischer–Maslow Left</span>: left the party ?]

[? if ultra_formed = 1 and ultra_expelled = 0 : {!<div class="rf-faction">!}<span class="f-ultra">Ultra-Left</span>{!<div class="rf-stat">!}Strength: [+ ultra_strength : strength +][+ n_ultra_strength +]{!</div><div class="rf-stat">!}Dissent: [+ ultra_dissent : rf_dissent +][+ n_ultra_dissent +]{!</div>!}{!</div>!} ?][? if ultra_formed = 1 and ultra_expelled = 1 : <span class="f-ultra">Ultra-Left</span>: left the party ?]

[? if stalin_formed = 1 and stalin_expelled = 0 : {!<div class="rf-faction">!}<span class="f-stalin">Thälmann circle</span>{!<div class="rf-stat">!}Strength: [+ stalin_strength : strength +][+ n_stalin_strength +]{!</div><div class="rf-stat">!}Dissent: [+ stalin_dissent : rf_dissent +][+ n_stalin_dissent +]{!</div>!}{!</div>!} ?][? if stalin_formed = 1 and stalin_expelled = 1 : <span class="f-stalin">Thälmann circle</span>: left the party ?]

[? if minor_formed = 1 : {!<div class="rf-faction">!}<span class="f-minor">Minor currents</span>{!<div class="rf-stat">!}Strength: [+ minor_strength : strength +][+ n_minor_strength +]{!</div><div class="rf-stat">!}Dissent: [+ minor_dissent : rf_dissent +][+ n_minor_dissent +]{!</div>!}{!</div>!} ?]

{!<span class="tooltip-text" title="The party's leadership between congresses, elected by the congress. The majority decides how many seats the other factions get; a faction with fewer seats than its strength grows angrier every month.">Zentrale</span>!}: [+ zentrale_text +]

