- @wg: Next: the workers' government.

@wg
new-page: true
on-arrival: {! window.RF.motionIntro(Q, 'leipzig', 'wg'); !}

= [+ mo_title +]

[+ mo_text +]

- @wg_theses
- @wg_amended
- @wg_counter

@wg_theses
title: Table the Zentrale's theses as drafted.
subtitle: A workers' government is a road to power, and Saxony is where the road begins. [+ mo_st_wg_theses +]
choose-if: mo_ok_wg_theses = 1
unavailable-subtitle: [+ mo_why_wg_theses +]
on-arrival: {! window.RF.motionVote(Q, 'leipzig', 'wg', 'theses'); !}
go-to: wg_done

@wg_amended
title: Table the theses with the commission's amendments: "a step, not a road".
subtitle: Such a government can only be born of the workers' struggle, and no Communist sits in it without the International's leave. [+ mo_st_wg_amended +]
choose-if: mo_ok_wg_amended = 1
unavailable-subtitle: [+ mo_why_wg_amended +]
on-arrival: {! window.RF.motionVote(Q, 'leipzig', 'wg', 'amended'); !}
go-to: wg_done

@wg_counter
title: Table <span class="m-maslow rf-person">Maslow</span>'s counter-theses.
subtitle: No coalitions with reformists: the workers' government is another name for the dictatorship of the proletariat, or it is nothing. [+ mo_st_wg_counter +]
choose-if: mo_ok_wg_counter = 1
unavailable-subtitle: [+ mo_why_wg_counter +]
on-arrival: {! window.RF.motionVote(Q, 'leipzig', 'wg', 'counter'); !}
go-to: wg_done

@wg_done
