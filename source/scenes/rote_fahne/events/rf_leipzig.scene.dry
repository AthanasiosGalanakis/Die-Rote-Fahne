@floor_cut
title: Back the chair and have her ruled out of order.
subtitle: Order will be restored. Berlin will not forget how. [+ mo_st_floor_cut +]
choose-if: mo_ok_floor_cut = 1
unavailable-subtitle: [+ mo_why_floor_cut +]
on-arrival: {! window.RF.motionVote(Q, 'leipzig', 'floor', 'cut'); !}
go-to: floor_done

@floor_pieck
title: Send <span class="m-pieck rf-person">Wilhelm Pieck</span> to the rostrum to calm the hall.
subtitle: Old Pieck has smoothed over worse quarrels than this one. [+ mo_st_floor_pieck +]
choose-if: mo_ok_floor_pieck = 1
unavailable-subtitle: [+ mo_why_floor_pieck +]
on-arrival: {! window.RF.motionVote(Q, 'leipzig', 'floor', 'pieck'); !}
go-to: floor_done

@floor_hear
title: Let her speak to the end.
subtitle: The majority will sit through it, if not quietly. [+ mo_st_floor_hear +]
choose-if: mo_ok_floor_hear = 1
unavailable-subtitle: [+ mo_why_floor_hear +]
on-arrival: {! window.RF.motionVote(Q, 'leipzig', 'floor', 'hear'); !}
go-to: floor_done

@floor_done
