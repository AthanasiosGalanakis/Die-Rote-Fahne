Q.rf_timers = ['rf_editorial', 'rf_district', 'rf_discipline', 'rf_apparatus',
               'rf_ruhr', 'rf_hundreds', 'rf_councils', 'rf_strike',
               'rf_underground', 'rf_delegation', 'rf_subsidy', 'rf_patron',
