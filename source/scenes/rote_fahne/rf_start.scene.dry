Q.right_strength = 42;   // Brandler, Thalheimer
Q.center_strength = 15;  // Meyer, Eberlein, Pieck
Q.left_strength = 25;    // Fischer, Maslow
Q.ultra_strength = 6;    // Korsch, Scholem, Rosenberg, Katz
Q.stalin_strength = 12;  // Thälmann's Hamburg circle, still inside the Left
Q.right_dissent = 5;
Q.center_dissent = 5;
Q.left_dissent = 20;
Q.ultra_dissent = 25;
Q.stalin_dissent = 10;
// how Moscow sees each faction (0-100)
Q.right_moscow = 55;
Q.center_moscow = 35;
Q.left_moscow = 40;
Q.ultra_moscow = 15;
Q.stalin_moscow = 25;
Q.right_expelled = 0;
Q.center_expelled = 0;
Q.left_expelled = 0;
Q.ultra_expelled = 0;
Q.stalin_expelled = 0;
Q.splits = 0;

// which faction holds the Zentrale
Q.leader = 'right';
// the Comintern line: united_front -> insurrection (Sep 1923) -> bolshevization (1924)
Q.line = 'united_front';
// party autonomy falls with every intervention from Moscow
Q.autonomy = 70;
// how far Moscow trusts the German party
Q.moscow_trust = 55;
// paid functionaries loyal to the leadership
Q.apparatus = 10;

// the party and Germany
Q.members = 220; // thousands; an estimate, published figures differ
Q.funds = 3;
Q.rev_situation = 45;
