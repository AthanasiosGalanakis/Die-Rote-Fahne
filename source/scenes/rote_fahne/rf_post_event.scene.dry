title: Post Event
new-page: true
on-arrival: {!
var RF = window.RF;
RF.normalize(Q);

// 1. advance the month once a card has been played
if (Q.month_actions >= 1) {
    Q.time += 1;
    Q.month_actions = 0;
    Q.month += 1;
    if (Q.month >= 13) {
        Q.month = 1;
        Q.year += 1;
    }
    // every countdown (a quality named *_timer) ticks down
    for (var t in Q) {
        if (/_timer$/.test(t) && Q[t] > 0) {
            Q[t] -= 1;
        }
    }

    // inflation drives the revolutionary situation up until the
    // Rentenmark (November 1923), then stabilisation drains it
    if (Q.year == 1923 && Q.month <= 10) {
        Q.rev_situation += 3;
    } else if (Q.year == 1923 && Q.month == 11) {
        Q.rev_situation -= 10;
    } else {
        Q.rev_situation -= 5;
    }

    // the Ruhr occupation feeds nationalism; hyperinflation eats the
    // Republic's support until the Rentenmark, then it slowly recovers
    if (Q.year == 1923 && Q.month <= 9) {
        Q.nationalism += 2;
        Q.pro_republic -= 2;
    } else if (Q.year == 1923 && Q.month <= 11) {
        Q.pro_republic -= 1;
    } else {
        Q.nationalism -= 1;
        Q.pro_republic += 2;
    }
    // the SPD's entry into Stresemann's grand coalition (August 1923)
    if (Q.year == 1923 && Q.month == 8) {
        Q.spd_discredit += 5;
    }

    // the leadership consolidates; factions out of step with the line grow restless
    Q[Q.leader + '_strength'] += 1;
    Q[Q.leader + '_dissent'] -= 1;
    for (var f of RF.factions) {
        if (f != Q.leader && !Q[f + '_expelled']) {
            Q[f + '_dissent'] += 1;
        }
    }
    if (Q.party_banned) {
        Q.members -= 6;
        Q.repression -= 2;
    }
    // Comintern plenums and party congresses on their historical dates
    RF.monthlyMoscow(Q);
    window.RF.checkAchievements(Q, 'anytime');
    // dues
    Q.funds += Q.members >= 150 ? 1 : 0;
    RF.normalize(Q);
}

// splits and endings are taken out for now (see archive/README.md)

// an event (a scene tagged rf_event) whose conditions are met comes next
Q.has_event = 0;
var scene = this.game.scenes['rf_post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices[0].title != "Continue...") {
    Q.has_event = 1;
}
!}
go-to: events_choice if has_event = 1; rf_main if has_event = 0

= [+ month : month +] [+ year +]

@events_choice

- #rf_event
